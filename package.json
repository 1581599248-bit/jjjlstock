{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "node scripts/apply-stock-reverse-label-style.mjs --normalize && node scripts/apply-fund-product-search-patch.mjs && node scripts/apply-stock-reverse-label-style.mjs && (node scripts/build-static-market-industries.mjs --period=2026-03-31 --minimum-classification-coverage=0.90 && node scripts/build-static-market-industries.mjs --period=2026-06-30 --minimum-classification-coverage=0.90 || echo 'market-industry static generation skipped; runtime fallback enabled') && vinext build",
    "start": "vinext start",
    "data:sync:fund-types": "node scripts/sync-fund-types.mjs",
    "data:build:q1": "node scripts/build-static-market.mjs --period=2026-03-31",
    "data:build:fund-exports:q1": "node scripts/build-static-fund-exports.mjs --period=2026-03-31",
    "data:enrich:scales:q1": "node scripts/enrich-static-fund-scales.mjs --period=2026-03-31",
    "data:build:sectors:q1": "node scripts/build-static-sectors.mjs --period=2026-03-31",
    "data:build:market-industries:q1": "node scripts/build-static-market-industries.mjs --period=2026-03-31",
    "data:build:stocks:q1": "node scripts/build-static-stock-search.mjs --period=2026-03-31",
    "data:validate:q1": "node scripts/validate-static-market.mjs --period=2026-03-31",
    "data:snapshot:q1": "node scripts/snapshot-current-market.mjs --period=2026-03-31",
    "data:refresh": "node scripts/refresh-quarter.mjs",
    "data:check": "node scripts/refresh-quarter.mjs --check-only=true",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/static-overview.test.mjs tests/static-stock-search.test.mjs tests/export-xlsx.test.mjs tests/stock-institution-export.test.mjs tests/fund-product-stock-search.test.mjs tests/market-industry-allocation.test.mjs tests/quarterly-refresh.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
